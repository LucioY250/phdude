{
  "$id": "phdude://result",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    { "$ref": "phdude://common#/$defs/base" },
    {
      "properties": {
        "schema": { "const": "phdude.result" },
        "summary": { "type": "string" },
        "from": { "type": "string" },
        "values": { "type": "object" },
        "state": { "$ref": "phdude://common#/$defs/state" }
      },
      "required": ["summary", "from", "values", "state"]
    }
  ],
  "unevaluatedProperties": false
}
