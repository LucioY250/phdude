{
  "$id": "phdude://common",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-phdude": { "stability": "stable", "since": "0.1" },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^(ART|SRC|CLAIM|EVID|FACT|RESULT|DEC|METH|CAND|SEARCH|DATASET|ANALYSIS|TABLE|FIG|REVIEW)-[0-9a-f]{10}$|^(RQ|H)-[0-9]+$"
    },
    "actor": {
      "type": "object",
      "properties": {
        "researcher": { "type": "string" },
        "agent": { "type": "string" }
      },
      "required": ["researcher"],
      "additionalProperties": false
    },
    "state": { "enum": ["canonical", "supported", "candidate", "disputed", "rejected"] },
    "provenance": {
      "type": "object",
      "properties": {
        "method": { "enum": ["agent-extraction", "manual", "imported"] },
        "derived_from": { "type": "array", "items": { "$ref": "#/$defs/id" } }
      },
      "required": ["method", "derived_from"],
      "additionalProperties": false
    },
    "base": {
      "type": "object",
      "properties": {
        "schema": { "type": "string" },
        "version": { "const": 1 },
        "id": { "$ref": "#/$defs/id" },
        "created": { "type": "string", "format": "date-time" },
        "actor": { "$ref": "#/$defs/actor" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "ext": { "type": "object" }
      },
      "required": ["schema", "version", "id", "created", "actor"]
    }
  }
}
