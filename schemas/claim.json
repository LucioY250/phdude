{
  "$id": "phdude://claim",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    { "$ref": "phdude://common#/$defs/base" },
    {
      "properties": {
        "schema": { "const": "phdude.claim" },
        "statement": { "type": "string" },
        "kind": { "enum": ["literature", "empirical", "theoretical", "methodological"] },
        "state": { "$ref": "phdude://common#/$defs/state" },
        "supported_by": { "type": "array", "items": { "$ref": "phdude://common#/$defs/id" } },
        "questions": { "type": "array", "items": { "$ref": "phdude://common#/$defs/id" } },
        "sections": { "type": "array", "items": { "type": "string" } },
        "contradicts": { "type": "array", "items": { "$ref": "phdude://common#/$defs/id" } },
        "provenance": { "$ref": "phdude://common#/$defs/provenance" }
      },
      "required": ["statement", "kind", "state", "supported_by", "questions", "sections"]
    }
  ],
  "unevaluatedProperties": false
}
