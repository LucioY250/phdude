{
  "name": "phdude",
  "version": "1.0.0",
  "description": "The senior researcher in your terminal. A field-agnostic research co-author harness for AI coding agents.",
  "license": "MIT",
  "keywords": [
    "research",
    "academic-writing",
    "thesis",
    "literature-review",
    "citations",
    "reproducibility",
    "knowledge-graph",
    "provenance",
    "agents-md",
    "claude-code",
    "codex",
    "opencode",
    "ai-agent",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LucioY250/phdude.git"
  },
  "homepage": "https://github.com/LucioY250/phdude#readme",
  "bugs": {
    "url": "https://github.com/LucioY250/phdude/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "phdude": "bin/phdude.js"
  },
  "files": [
    "bin",
    "src",
    "schemas",
    "migrations",
    "defaults",
    "skills",
    "commands",
    "packs",
    "generators",
    "docs/agents.md",
    "docs/cli.md",
    "docs/guide.md",
    "docs/examples.md",
    "docs/extending.md",
    "docs/extension-api.md",
    "docs/migration.md",
    "docs/non-goals.md",
    "docs/packs-authoring.md",
    "docs/skills-authoring.md",
    "docs/versioning.md",
    "docs/workspace.md",
    "docs/adr",
    "docs/assets",
    "docs/assets/demo.svg",
    "!docs/assets/diagrams/*.excalidraw",
    "!docs/assets/fonts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "validate": "node --test tests/unit/schemas.test.js tests/unit/skills.test.js tests/contracts/schema-stability.test.js tests/contracts/skills.test.js tests/contracts/packs.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "example": "node scripts/make-example.mjs",
    "examples": "node scripts/make-examples.mjs",
    "example:all": "npm run example && npm run examples",
    "fixtures": "node scripts/make-fixtures.mjs",
    "diagrams": "node scripts/make-diagrams.mjs",
    "demo": "node scripts/make-demo.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "fflate": "^0.8.2",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "prettier": "^3.4.2"
  }
}
