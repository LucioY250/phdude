{
  "$id": "phdude://source",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    { "$ref": "phdude://common#/$defs/base" },
    {
      "properties": {
        "schema": { "const": "phdude.source" },
        "title": { "type": "string" },
        "authors": { "type": "array", "items": { "type": "string" } },
        "year": { "type": "integer" },
        "venue": { "type": "string" },
        "doi": { "type": "string" },
        "url": { "type": "string" },
        "type": {
          "enum": [
            "article",
            "book",
            "chapter",
            "thesis",
            "report",
            "preprint",
            "web",
            "dataset",
            "other"
          ]
        },
        "artifacts": { "type": "array", "items": { "$ref": "phdude://common#/$defs/id" } },
        "state": { "$ref": "phdude://common#/$defs/state" },
        "bibkey": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "abstract": { "type": "string" },
        "keywords": { "type": "array", "items": { "type": "string" } },
        "identifiers": {
          "type": "object",
          "properties": {
            "doi": { "type": "string", "pattern": "^10\\.\\d{4,9}/\\S+$" },
            "isbn": { "type": "string" },
            "arxiv": { "type": "string" },
            "pmid": { "type": "string" },
            "url": { "type": "string" }
          },
          "additionalProperties": false
        },
        "provenance": { "$ref": "phdude://common#/$defs/provenance" }
      },
      "required": ["title", "authors", "type", "artifacts", "state"]
    }
  ],
  "unevaluatedProperties": false
}
